#!/usr/bin/env python3
# hyprmorph-settings: a small GTK window to tune the hyprmorph plugin.
# Writes ~/.config/hyprmorph/settings.conf; the plugin picks changes up live
# (between morphs), so every slider takes effect on the next window change.
import json
import os
import subprocess
import threading
import time

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402

CONF = os.path.expanduser("~/.config/hyprmorph/settings.conf")
THEME = os.path.expanduser("~/.config/ml4w/colors/colors.json")

DEFAULTS = {
    "morph_workspaces": True,
    "morph_windows": True,
    "drag_blob": True,
    "pixel_size": 3,
    "detail": 0.10,
    "duration": 0.30,
    "stagger": 0.35,
    "curl": 0.18,
    "color_mode": "window",
    "color_strength": 0.70,
    "custom_color": "#ff3d81",
    "custom_color2": "#7c4dff",
    "blob_size": 160,
    "blob_trail": 1.6,
    "blob_wobble": 1.0,
    "bar_morph": True,
    "bar_morph_duration": 0.45,
    "bar_morph_pixel": 2,
}
MODES = [("window", "Window colours"), ("theme", "Theme colours (from the wallpaper)"), ("custom", "Custom colours")]


def load():
    cfg = dict(DEFAULTS)
    try:
        for line in open(CONF):
            if "=" not in line or line.lstrip().startswith("#"):
                continue
            k, v = (x.strip() for x in line.split("=", 1))
            if k not in DEFAULTS:
                continue
            d = DEFAULTS[k]
            cfg[k] = v.lower() in ("true", "1", "yes") if isinstance(d, bool) else type(d)(float(v)) if isinstance(d, (int, float)) else v
    except (OSError, ValueError):
        pass
    return cfg


def save(cfg):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write("# hyprmorph settings (edited by hyprmorph-settings; read live by the plugin)\n")
        for k in DEFAULTS:
            v = cfg[k]
            f.write(f"{k} = {str(v).lower() if isinstance(v, bool) else (round(v, 3) if isinstance(v, float) else v)}\n")
    os.replace(tmp, CONF)


def theme_colors():
    try:
        d = json.load(open(THEME))
        return d.get("primary", "#ffffff"), d.get("tertiary", "#ffffff")
    except (OSError, ValueError):
        return "#ffffff", "#ffffff"


def rgba(hexstr):
    c = Gdk.RGBA()
    c.parse(hexstr)
    return c


def to_hex(c):
    return "#{:02x}{:02x}{:02x}".format(round(c.red * 255), round(c.green * 255), round(c.blue * 255))


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Morph settings", default_width=620, default_height=860)
        self.cfg = load()
        self.pending = None
        self.widgets = {}

        header = Adw.HeaderBar()
        preview = Gtk.Button(label="Preview")
        preview.add_css_class("suggested-action")
        preview.set_tooltip_text("Switch to the next workspace and back to see the morph")
        preview.connect("clicked", self.on_preview)
        header.pack_end(preview)
        reset = Gtk.Button(icon_name="edit-undo-symbolic", tooltip_text="Reset to defaults")
        reset.connect("clicked", self.on_reset)
        header.pack_start(reset)

        page = Adw.PreferencesPage()

        g = Adw.PreferencesGroup(title="Effects", description="Which changes are animated.")
        g.add(self.switch("morph_workspaces", "Workspace switches", "The old desktop's pixels fly into the new one"))
        g.add(self.switch("morph_windows", "Window changes", "Open, close, resize, fullscreen, layout"))
        g.add(self.switch("drag_blob", "Drag blob", "SUPER + drag turns the window into a blob of its pixels"))
        page.add(g)

        g = Adw.PreferencesGroup(title="Colours", description="Colour of the pixels while they fly.")
        mode = Adw.ComboRow(title="Pixel colour", model=Gtk.StringList.new([m[1] for m in MODES]))
        mode.set_selected([m[0] for m in MODES].index(self.cfg["color_mode"]) if self.cfg["color_mode"] in [m[0] for m in MODES] else 0)
        mode.connect("notify::selected", self.on_mode)
        g.add(mode)
        self.strength = self.scale("color_strength", "Colour strength", "How strongly pixels take the colour", 0, 1, 0.05, 2)
        g.add(self.strength)
        self.theme_row = Adw.ActionRow(title="Theme colours", subtitle="Follow the wallpaper (or the colour picked with SUPER+ALT+C)")
        self.swatches = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        self.theme_row.add_suffix(self.swatches)
        g.add(self.theme_row)
        self.custom_rows = [self.color("custom_color", "Colour 1"), self.color("custom_color2", "Colour 2", "Pixels get a mix between the two")]
        for r in self.custom_rows:
            g.add(r)
        page.add(g)

        g = Adw.PreferencesGroup(title="Pixels")
        g.add(self.scale("pixel_size", "Pixel size", "Bigger pixels: fewer, chunkier particles", 2, 12, 1, 0))
        g.add(self.scale("detail", "Detail sensitivity", "Lower: more of each window flies as pixels", 0.03, 0.4, 0.01, 2))
        page.add(g)

        g = Adw.PreferencesGroup(title="Motion")
        g.add(self.scale("duration", "Duration", "Seconds per morph", 0.1, 2.0, 0.05, 2))
        g.add(self.scale("stagger", "Stagger", "How spread out the take-offs are", 0, 0.85, 0.05, 2))
        g.add(self.scale("curl", "Curve", "How much each pixel's path bends", 0, 0.8, 0.02, 2))
        page.add(g)

        g = Adw.PreferencesGroup(title="Drag blob")
        g.add(self.scale("blob_size", "Size", "Half of the blob's longer side, in pixels", 60, 400, 10, 0))
        g.add(self.scale("blob_trail", "Trail length", "In blob sizes (0 = no trail)", 0, 4, 0.1, 1))
        g.add(self.scale("blob_wobble", "Wobble", "Outline waves and fizzing rim", 0, 3, 0.1, 1))
        page.add(g)

        g = Adw.PreferencesGroup(title="Bar & dock", description="The ML4W bar and dock appear and disappear as a pixel morph instead of sliding.")
        g.add(self.switch("bar_morph", "Pixel morph", "Cells fly in from / out to the screen edge"))
        g.add(self.scale("bar_morph_duration", "Duration", "Seconds", 0.15, 1.5, 0.05, 2))
        g.add(self.scale("bar_morph_pixel", "Pixel size", "Size of the flying cells", 1, 8, 1, 0))
        page.add(g)

        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(page)
        self.set_content(view)
        self.refresh_mode()
        GLib.timeout_add_seconds(2, self.refresh_swatches)
        self.refresh_swatches()

    # ---------------------------------------------------------- rows ---
    def switch(self, key, title, subtitle):
        row = Adw.SwitchRow(title=title, subtitle=subtitle, active=self.cfg[key])
        row.connect("notify::active", lambda r, _p: self.set(key, r.get_active()))
        self.widgets[key] = row
        return row

    def scale(self, key, title, subtitle, lo, hi, step, digits):
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        sc.set_digits(digits)
        sc.set_draw_value(True)
        sc.set_value_pos(Gtk.PositionType.LEFT)
        sc.set_size_request(260, -1)
        sc.set_valign(Gtk.Align.CENTER)
        sc.set_value(self.cfg[key])
        isint = isinstance(DEFAULTS[key], int)
        sc.connect("value-changed", lambda s: self.set(key, int(round(s.get_value())) if isint else round(s.get_value(), 3)))
        row.add_suffix(sc)
        self.widgets[key] = sc
        return row

    def color(self, key, title, subtitle=None):
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        btn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False), valign=Gtk.Align.CENTER)
        btn.set_rgba(rgba(self.cfg[key]))
        btn.connect("notify::rgba", lambda b, _p: self.set(key, to_hex(b.get_rgba())))
        row.add_suffix(btn)
        self.widgets[key] = btn
        return row

    # -------------------------------------------------------- state ---
    def set(self, key, value):
        self.cfg[key] = value
        if self.pending:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(150, self.flush)

    def flush(self):
        self.pending = None
        save(self.cfg)
        return False

    def on_mode(self, row, _p):
        self.set("color_mode", MODES[row.get_selected()][0])
        self.refresh_mode()

    def refresh_mode(self):
        m = self.cfg["color_mode"]
        self.strength.set_sensitive(m != "window")
        self.theme_row.set_visible(m == "theme")
        for r in self.custom_rows:
            r.set_visible(m == "custom")

    def refresh_swatches(self):
        child = self.swatches.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.swatches.remove(child)
            child = nxt
        for c in theme_colors():
            sw = Gtk.DrawingArea(content_width=28, content_height=28)
            col = rgba(c)

            def draw(_a, cr, w, h, col=col):
                cr.set_source_rgb(col.red, col.green, col.blue)
                cr.arc(w / 2, h / 2, min(w, h) / 2 - 1, 0, 6.2832)
                cr.fill()

            sw.set_draw_func(draw)
            self.swatches.append(sw)
        return True

    def on_reset(self, _b):
        self.cfg = dict(DEFAULTS)
        save(self.cfg)
        self.close()
        Window(self.get_application()).present()

    def on_preview(self, _b):
        self.flush()

        def run():
            time.sleep(0.6)  # the plugin re-reads settings at most twice a second
            try:
                ws = json.loads(subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True).stdout)["id"]
            except (ValueError, KeyError):
                return
            subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{ workspace = {ws + 1} }})"], capture_output=True)
            time.sleep(max(0.9, self.cfg["duration"] + 0.5))
            subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{ workspace = {ws} }})"], capture_output=True)

        threading.Thread(target=run, daemon=True).start()


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="io.github.guizzan.HyprmorphSettings")

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == "__main__":
    App().run(None)
